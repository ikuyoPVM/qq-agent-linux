{
  "name": "qq-agent",
  "version": "0.4.5",
  "private": false,
  "description": "QQ 群 AI 机器人（Ubuntu 服务器版）：事件驱动的无状态 Agent，接 OpenAI 兼容 API，无头控制台 + systemd。上游 Kondius/qq-agent，基于洛版的二次修改。",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "cn.kondius.qq-agent",
    "productName": "QQ Agent",
    "artifactName": "qq-agent-v0.3-setup.exe",
    "asar": false,
    "files": [
      "**/*",
      "!data/**",
      "!community.key",
      "!community.key.example",
      "!server/**",
      "!snowluma/config/**",
      "!snowluma/data/**",
      "!snowluma/logs/**",
      "!test/**",
      "!doc/**",
      "!scripts/**",
      "!dist/**",
      "!**/*.map",
      "!package-lock.json.bak",
      "!task_plan.md",
      "!findings.md",
      "!progress.md",
      "!*.log"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "QQ Agent",
      "include": "build/installer.nsh"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "setup:napcat": "node scripts/setup-napcat.mjs",
    "test": "node test/selftest.mjs && node test/community-test.mjs && node test/skill-test.mjs && node test/tools-skill-audit.mjs && node test/media-links-test.mjs && node test/conversation-memory-test.mjs && node test/image-generate-download-test.mjs && node test/reply-rescue-test.mjs && node test/skill-settings-e2e.mjs && node test/sticker-context.mjs && node test/skill-modal-ui.mjs && node test/render-test.mjs && node test/scroll-test.mjs && node test/usage-e2e.mjs && node test/usage-daily-test.mjs && node test/test-prompt.mjs && node test/cache-stability-test.mjs && node test/prompt-dedup-warm-test.mjs && node test/fetch-models-diagnostics-test.mjs && node test/setup-qq-version.mjs && node test/setup-download.mjs && node test/qq-pack.mjs && node test/qq-process-detect.mjs && node test/sender-file-uri-test.mjs && node test/sender-send-path-test.mjs && node test/vendor-mirror-test.mjs && node test/safe-fetch-file-test.mjs",
    "test:coverage": "node test/coverage-offline.mjs && node test/coverage-http.mjs && node test/coverage-e2e.mjs && node test/coverage-ui.mjs && node test/coverage-wiring.mjs",
    "test:all": "npm test && npm run test:coverage",
    "test:prompt": "node test/test-prompt.mjs",
    "test:render": "node test/render-test.mjs",
    "test:scroll": "node test/scroll-test.mjs",
    "test:usage": "node test/usage-e2e.mjs",
    "test:skill": "node test/skill-test.mjs",
    "new:skill": "node scripts/new-skill.mjs",
    "test:wiring": "node test/coverage-wiring.mjs",
    "test:audit": "node test/tools-skill-audit.mjs",
    "test:media": "node test/media-links-test.mjs",
    "test:rescue": "node test/reply-rescue-test.mjs",
    "check:protocol": "node scripts/protocol-check.mjs",
    "check:judge": "node scripts/judge-check.mjs",
    "test:skillui": "node test/skill-modal-ui.mjs",
    "test:setuppin": "node test/setup-qq-version.mjs",
    "test:download": "node test/setup-download.mjs",
    "pack:qq": "node scripts/pack-qq-portable.mjs",
    "test:qqpack": "node test/qq-pack.mjs",
    "test:qqproc": "node test/qq-process-detect.mjs",
    "test:safefile": "node test/safe-fetch-file-test.mjs",
    "test:memory": "node test/conversation-memory-test.mjs",
    "test:imagegen": "node test/image-generate-download-test.mjs",
    "test:sender": "node test/sender-file-uri-test.mjs && node test/sender-send-path-test.mjs",
    "check:load": "node scripts/preload-check.mjs",
    "headless": "node src/server.js",
    "start:linux": "node src/server.js"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1"
  },
  "license": "MIT",
  "author": "Kondius",
  "keywords": [
    "qq",
    "bot",
    "agent",
    "openai",
    "onebot",
    "llm",
    "desktop",
    "electron",
    "linux",
    "ubuntu",
    "server",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ikuyoPVM/qq-agent-linux.git"
  },
  "bugs": {
    "url": "https://github.com/ikuyoPVM/qq-agent-linux/issues"
  },
  "homepage": "https://github.com/ikuyoPVM/qq-agent-linux#readme"
}
